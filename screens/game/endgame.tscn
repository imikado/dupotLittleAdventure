[gd_scene format=3]

[ext_resource type="Script" path="res://screens/game/endgame.gd" id="1"]
[ext_resource type="Theme" path="res://common/themes/default.tres" id="2"]

[node name="endgame" type="CanvasLayer"]
layer = 5
script = ExtResource("1")

[node name="backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.06, 0.02, 0.65)

[node name="window" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -90.0
offset_top = -46.0
offset_right = 90.0
offset_bottom = 46.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")

[node name="list" type="VBoxContainer" parent="window"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="title" type="Label" parent="window/list"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 24
theme_override_constants/outline_size = 6
text = "Fin"
horizontal_alignment = 1

[node name="message" type="Label" parent="window/list"]
layout_mode = 2
theme_type_variation = &"DarkLabel"
text = "Le puits est réparé !"
horizontal_alignment = 1

[node name="button" type="Button" parent="window/list"]
layout_mode = 2
size_flags_horizontal = 4
text = "Retour au menu"

[connection signal="pressed" from="window/list/button" to="." method="_on_button_pressed"]
